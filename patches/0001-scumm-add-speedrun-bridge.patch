+
+namespace Common {
+class JSONValue;
+}
+
+namespace Scumm {
+
+class ScummEngine;
+
+/** One C3 condition (docs/plan.md, contract C3). */
+struct SpeedrunCondition {
+	enum Kind { kVar, kBit, kRoom, kOwner, kState, kHas, kActorRoom, kActorX, kActorY };
+	enum Op { kEq, kLe, kGe };
+
+	Kind kind;
+	int32 subject; // var or bit index, room, object or actor
+	Op op;
+	int32 value;   // unused for kRoom and kHas
+	bool negate;
+};
+
+typedef Common::Array<SpeedrunCondition> SpeedrunConditions;
+
+/**
+ * Parse a JSON array of C3 conditions, accepting exactly the forms of
+ * src/speedrun/conditions.py. On failure returns false and sets @p error.
+ */
+bool parseSpeedrunConditions(const Common::String &json, SpeedrunConditions &out, Common::String &error);
+/** Same, for an already parsed JSON value (which must be an array). */
+bool parseSpeedrunConditionArray(const Common::JSONValue *value, SpeedrunConditions &out, Common::String &error);
+
+/** One entry of a plan step's `click` list (contract C4). */
+struct SpeedrunClick {
+	bool inventory = false; // false: {"verb": id}; true: {"inventory": obj[, "offset": n]}
+	int32 value = 0;        // verb id or object id
+	int32 offset = 0;
+};
+
+/** One plan step (contract C4). */
+struct SpeedrunStep {
+	Common::String action;
+	bool hasVerb = false;
+	int32 verb = 0, obj = 0, obj2 = 0;
+	bool hasRoom = false;
+	int32 room = 0;
+	Common::Array<SpeedrunClick> clicks;
+	Common::Array<Common::String> choose; // ASCII substrings, matched case-insensitively
+	SpeedrunConditions until;
+};
+
+/**
+ * Parse a plan (JSONL, one step per line; blank lines are skipped) with the
+ * exact keys of src/speedrun/compiler.py C4_KEYS. On failure returns false
+ * and sets @p error. In speedrun_plan_parser.cpp.
+ */
+bool parseSpeedrunPlan(const Common::String &text, Common::Array<SpeedrunStep> &out, Common::String &error);
+
+/**
+ * Speedrun bridge: lets an external harness run the game headless, on a
+ * deterministic tick clock, and observe it through a JSONL trace.
+ *
+ * Inert unless the SPEEDRUN_OUT environment variable is set: create() then
+ * returns nullptr and every hook in ScummEngine is a null-pointer check.
+ *
+ * Hooks (engines/scumm/scumm.cpp):
+ *  - init(), first statement:                 create()
+ *  - go(), before setTotalPlayTime():         onBoot()
+ *  - scummLoop(), first statement:            onFrameBegin(delta)
+ *  - scummLoop(), before checkAndRunSentenceScript(): onDecisionPoint()
+ *  - waitForTimer():                          skipWaits()
+ *  - ~ScummEngine(), first statement:         delete
+ *
+ * Environment (contract C1; all read once, in create()):
+ *  - SPEEDRUN_OUT=<dir>          output dir: trace.jsonl, objects.json, state-*.json
+ *  - SPEEDRUN_FAST=1             no real-time waiting between frames
+ *  - SPEEDRUN_MAX_TICKS=<n>      watchdog: end "max_ticks" once ticks >= n
+ *  - SPEEDRUN_DUMP_OBJECTS=1     objects.json at the first idle frame, then end "dump_done"
+ *  - SPEEDRUN_START=<json>       segment start conditions, checked on sentence-idle frames
+ *  - SPEEDRUN_GOAL=<json>        goal conditions, checked once the segment has started;
+ *                                unset or [] means no goal
+ *  - SPEEDRUN_PLAN, SPEEDRUN_INVENTORY, SPEEDRUN_STEP_TIMEOUT: stored for the plan player
+ * The RNG seed is ScummVM's own --random-seed (ConfMan "random_seed").
+ *
+ * Record stamping (contract C2): records about the completed previous frame
+ * (saveload, goal, stall) are written at the top of onFrameBegin() with the
+ * counters before this frame's delta; records decided at the decision point
+ * (segment_start) and the watchdog use the counters after it.
+ */
+class SpeedrunBridge {
+public:
+	/** nullptr unless SPEEDRUN_OUT is set. Opens the trace, installs the error handler. */
+	static SpeedrunBridge *create(ScummEngine *vm);
+	/** Writes an end record with reason "quit" unless the run already ended. */
+	~SpeedrunBridge();
+
+	/** go(), before the boot script runs: writes the boot record. */
+	void onBoot();
+	/**
+	 * First statement of scummLoop(): the previous frame has completed and
+	 * processInput() has not run yet. @p delta is the unclamped tick delta
+	 * (jiffies of 1/60 s).
+	 */
+	void onFrameBegin(int delta);
+	/** scummLoop(), right before checkAndRunSentenceScript(). */
+	void onDecisionPoint();
+	/** waitForTimer(): true skips the real-time wait (SPEEDRUN_FAST). */
+	bool skipWaits() const { return _skipWaits; }
+
+private:
+	enum IdleKind { kNotIdle, kIdleSentence, kIdleDialog };
+
+	/** What the decision point saw: an idle kind, or what blocks idle. */
+	struct IdleState {
+		IdleKind kind = kNotIdle;
+		const char *blocker = nullptr; // stall reason when not idle
+		int slot = -1;                 // script slot behind the blocker, if any
+		int script = -1;               // script number in that slot
+	};
+
+	explicit SpeedrunBridge(ScummEngine *vm);
+	SpeedrunBridge(const SpeedrunBridge &) = delete;
+	SpeedrunBridge &operator=(const SpeedrunBridge &) = delete;
+
+	void readEnv();
+	void validateEnv();
+
+	/** onFrameBegin, step 1: checks on the completed previous frame. */
+	void observePreviousFrame();
+	void neutraliseInput();
+	void pumpAudio(int delta);
+
+	// Idle detection (speedrun_state.cpp)
+	static IdleState blocked(const char *reason, int slot = -1, int script = -1);
+	IdleState evaluateIdle() const;
+	bool verbVisible(int slot) const;
+	bool anyVisibleVerb(int firstId, int lastId) const;
+	bool slotWaitsForMessage(int slot) const;
+
+	// Conditions (speedrun_conditions.cpp)
+	bool conditionHolds(const SpeedrunCondition &cond) const;
+	bool allHold(const SpeedrunConditions &conds) const;
+	/** Error @p code unless every index, object and actor exists in this game. */
+	void checkConditionRanges(const SpeedrunConditions &conds, const char *what, const char *code);
+
+	// Dumps (speedrun_state.cpp)
+	/**
+	 * Verb slot text, raw bytes with escapes stripped. @p rendered expands
+	 * variable, verb and name references as drawVerb() shows them; otherwise
+	 * they are dropped, which gives the verb's state-independent name.
+	 * False for image verbs and empty slots.
+	 */
+	bool verbText(int slot, bool rendered, Common::String &out) const;
+	Common::String verbJson(int slot, bool rendered) const;
+	/** Ego's inventory in display order (findInventory() is 1-based). */
+	Common::Array<int> egoInventory() const;
+	Common::String stateJson() const;
+	Common::String objectsJson();
+	/** Write $SPEEDRUN_OUT/@p name whole (atomically); engine_error if that fails. */
+	bool writeFile(const char *name, const Common::String &contents);
+
+	// Run control
+	void startSegment();
+	void reachGoal();
+	void maybeReportStall();
+	/** What kept the run from progressing at this decision point (nullptr: nothing). */
+	void setBlocker(const char *reason, int slot = -1, int script = -1);
+	/** Something happened (idle without a blocker, or a step action): restart the stall clock. */
+	void markProgress();
+
+	// Plan player (speedrun_plan.cpp)
+	void loadPlan();
+	void runPlan();
+	bool tryStartStep();
+	/**
+	 * What keeps the active (pending) step from acting (starting) at this
+	 * decision point, named as stall records name it; nullptr if nothing.
+	 */
+	const char *activeStepBlocker() const;
+	const char *pendingStepBlocker() const;
+	void startStep();
+	void completeStep();
+	void performClick();
+	void answerChoice();
+	/** Visible dialogue choices, by verb id, as "id: text" for messages. */
+	Common::String visibleChoices() const;
+	void takeSnapshot();
+	Common::String changesJson() const;
+
+	/** End the run: end record, close the trace, quitGame(). Idempotent. */
+	void finish(const char *reason);
+	/** Error record with @p code, then finish("error"). */
+	void fail(const char *code, const Common::String &message);
+	/** Index of the step an error record names, or -1 (no plan, or plan done). */
+	int errorStep() const;
+	/** Report through ScummVM's error(), which never returns; the error record gets @p code. */
+	void raiseError(const char *code, const Common::String &message);
+	/**
+	 * Write the optional error record and the end record, then close the trace.
+	 * Marks the run finished before writing. Returns false if it already was.
+	 */
+	bool endTrace(const char *reason, const char *errorCode, const char *errorMessage);
+	static bool errorHandler(const char *msg);
+
+	// Trace (contract C5): one JSON object per line, flushed after each
+	/** A record with "type", "tick" and "frame"; callers add the rest. */
+	JsonObject record(const char *type) const;
+	void writeRecord(const JsonObject &rec);
+	/** FNV-1a 32 over _scummVars[0.._numVariables) as little-endian int32s. */
+	Common::String varsFingerprint() const;
+
+	ScummEngine *_vm;
+
+	// Configuration (contract C1)
+	Common::String _outDir;
+	bool _skipWaits = false;
+	bool _pumpAudio = false;
+	bool _hasMaxTicks = false;
+	uint64 _maxTicks = 0;
+	bool _dumpObjects = false;
+	Common::String _planPath;
+	SpeedrunConditions _start;      // SPEEDRUN_START; empty = first sentence-idle frame
+	SpeedrunConditions _goal;       // SPEEDRUN_GOAL; empty = no goal
+	struct InventoryLayout {        // SPEEDRUN_INVENTORY
+		bool valid = false;
+		int32 verbFirst = 0, count = 0, varFirst = 0;
+	} _inventory;
+	uint64 _stepTimeout = 36000;    // ticks; 10 minutes of game time
+	Common::String _envError;       // first invalid variable, reported once the trace is open
+
+	// Run clock (contract C2): ticks = sum of unclamped deltas since boot
+	uint64 _ticks = 0;
+	uint64 _frames = 0;
+
+	// Segment and idle tracking
+	bool _segmentStarted = false;
+	uint64 _tick0 = 0;
+	IdleState _lastIdle;            // from the latest decision point
+	int _idleStreak = 0;            // consecutive decision points of _lastIdle.kind (idle only)
+	IdleState _blocker;             // what blocked progress at the latest decision point
+	uint64 _progressTick = 0;       // latest decision point with nothing blocking (0 = boot)
+	uint64 _stallTick = 0;          // tick of the latest stall record in this streak
+	bool _stallReported = false;
+
+	// Plan player
+	Common::Array<SpeedrunStep> _plan;
+	bool _hasPlan = false;
+	uint _stepIndex = 0;            // the active step, or the next one to start
+	bool _stepActive = false;
+	bool _planDone = false;
+	uint64 _planDoneTick = 0;
+	uint64 _stepWaitSince = 0;      // when the pending step became next
+	uint64 _stepStartTick = 0;
+	uint _clickIndex = 0;           // next click of the active step
+	uint _chooseIndex = 0;          // next choose entry of the active step
+	bool _menuAnswered = false;     // an answered menu has not gone away yet
+	Common::Array<int32> _snapVars; // state at step start, for step_end changes
+	Common::Array<byte> _snapBits;
+	Common::Array<int> _snapInventory;
+	int _snapRoom = 0;
+
+	// Tick-locked audio (null mixer, --disable-sdl-audio)
+	static const uint kAudioChunkFrames = 512;
+	uint _audioRate = 0;            // mixer output rate, frames per second
+	uint _audioFrameBytes = 4;      // 16-bit stereo
+	uint64 _audioRemainder = 0;     // sub-frame remainder, in 1/60 frames
+	uint64 _audioPending = 0;       // whole frames owed to the mixer (< one chunk after pumping)
+	uint64 _audioPumped = 0;        // frames mixed so far
+	int16 _audioBuf[kAudioChunkFrames * 2];
+
+	JsonlWriter _trace;            // $SPEEDRUN_OUT/trace.jsonl, written in place
+	const char *_errorCode = "engine_error"; // code for the next error() record
+	bool _finished = false;
+};
+
+} // End of namespace Scumm
+
+#endif
