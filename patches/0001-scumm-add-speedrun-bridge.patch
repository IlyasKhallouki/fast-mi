+// MI1 verb ids, from the decompiled scripts (data/scripts):
+// - Action verbs 2..10 (Open, Close, Give, Push, Pull, Use, Look at, Pick up,
+//   Talk to) are created On() by global/script-022.txt [002F]-[00D0]. "Walk to"
+//   (11) is the implicit default verb, created Off() at [001F], so it never
+//   shows in the verb bar.
+// - Dialogue choices are verbs 120..128: global/script-017.txt creates them at
+//   [00D4]-[014C] (keys '1'..'9') and [0286]-[02EE]; menus fill them through
+//   VerbOps(Var[100] = 120 + k) (e.g. room-038-lookout/local-202.txt [013E]),
+//   and the dialogue input script global/script-014.txt maps a click on 120+k
+//   back to Var[250 + k] and turns 120..128 off again ([0013]-[0078],
+//   [00AA]-[00B7]). Not yet confirmed against live verb slots in a menu: no
+//   menu is reachable before the plan player (task 1.3).
+// - Not used here: prepositions 129..132 (script-022 [01C8]-[01E5]), the
+//   sentence line 100, inventory arrows 109/110, inventory slots 200..207.
+const int kActionVerbFirst = 2, kActionVerbLast = 10;
+const int kDialogVerbFirst = 120, kDialogVerbLast = 128;
+
+// o5_wait and its SO_WAIT_FOR_MESSAGE sub-opcode (script_v5.cpp).
+const byte kOpWait = 0xAE, kWaitForMessage = 2;
+
+// Bytes of a script string as drawn: '@' padding dropped and 0xFF/0xFE escape
+// sequences removed. drawString() treats both as escape introducers in v<=6
+// (string.cpp); codes 9, 10, 12, 13 and 14 carry a 16-bit argument.
+Common::String stripEscapes(const byte *s, uint32 maxLen) {
+	Common::String out;
+	for (uint32 i = 0; i < maxLen && s[i]; i++) {
+		const byte c = s[i];
+		if (c == 0xFF || c == 0xFE) {
+			if (i + 1 >= maxLen || !s[i + 1])
+				break;
+			const byte code = s[i + 1];
+			const uint32 len = (code == 9 || code == 10 || code == 12 || code == 13 || code == 14) ? 4 : 2;
+			i += len - 1;
+			continue;
+		}
+		if (c != '@')
+			out += (char)c;
+	}
+	return out;
+}
+
+Common::String withoutAt(const byte *s) {
+	Common::String out;
+	for (; s && *s; ++s) {
+		if (*s != '@')
+			out += (char)*s;
+	}
+	return out;
+}
+
+Common::String pointJson(int x, int y) {
+	return JsonArray().add(x).add(y).str();
+}
+
+Common::String classesJson(uint32 bits) {
+	JsonArray classes;
+	for (int bit = 0; bit < 32; bit++) {
+		if (bits & (1u << bit))
+			classes.add(bit + 1); // getClass(obj, cls) tests bit cls-1 (object.cpp)
+	}
+	return classes.str();
+}
+
+} // End of anonymous namespace
