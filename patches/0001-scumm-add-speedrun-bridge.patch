+
+namespace Scumm {
+
+class ScummEngine;
+
+/**
+ * JSON string literal, pure ASCII: escapes quotes, backslashes and control
+ * characters; bytes >= 0x80 become \u00XX (the byte read as Latin-1).
+ * nullptr gives null.
+ */
+Common::String jsonString(const char *s);
+
+/** Builds one JSON object; members appear in the order they are added. */
+class JsonObject {
+public:
+	JsonObject &add(const char *key, int value);
+	JsonObject &add(const char *key, uint value);
+	JsonObject &add(const char *key, int64 value);
+	JsonObject &add(const char *key, uint64 value);
+	JsonObject &add(const char *key, bool value);
+	/** nullptr gives null. */
+	JsonObject &add(const char *key, const char *value);
+	JsonObject &add(const char *key, const Common::String &value);
+	JsonObject &addNull(const char *key);
+	/** @p json must already be valid JSON (a nested object or array). */
+	JsonObject &addRaw(const char *key, const Common::String &json);
+	Common::String str() const;
+
+private:
+	Common::String _members; // comma-separated "key":value pairs
+};
+
+/**
+ * Speedrun bridge: lets an external harness run the game headless, on a
+ * deterministic tick clock, and observe it through a JSONL trace.
+ *
+ * Inert unless the SPEEDRUN_OUT environment variable is set: create() then
+ * returns nullptr and every hook in ScummEngine is a null-pointer check.
+ *
+ * Hooks (engines/scumm/scumm.cpp):
+ *  - init(), first statement:                 create()
+ *  - go(), before setTotalPlayTime():         onBoot()
+ *  - scummLoop(), first statement:            onFrameBegin(delta)
+ *  - scummLoop(), before checkAndRunSentenceScript(): onDecisionPoint()
+ *  - waitForTimer():                          skipWaits()
+ *  - ~ScummEngine(), first statement:         delete
+ *
+ * Environment (contract C1; all read once, in create()):
+ *  - SPEEDRUN_OUT=<dir>          output dir; trace.jsonl is written there
+ *  - SPEEDRUN_FAST=1             no real-time waiting between frames
+ *  - SPEEDRUN_MAX_TICKS=<n>      watchdog: end "max_ticks" once ticks >= n
+ *  - SPEEDRUN_DUMP_OBJECTS, SPEEDRUN_PLAN, SPEEDRUN_START, SPEEDRUN_GOAL,
+ *    SPEEDRUN_INVENTORY, SPEEDRUN_STEP_TIMEOUT: parsed and stored for later stages
+ * The RNG seed is ScummVM's own --random-seed (ConfMan "random_seed").
+ *
+ * Record stamping (contract C2): records about the completed previous frame
+ * are written at the top of onFrameBegin() with the counters before this
+ * frame's delta; records about the current frame (decision point, watchdog)
+ * use the counters after it.
+ */
+class SpeedrunBridge {
+public:
+	/** nullptr unless SPEEDRUN_OUT is set. Opens the trace, installs the error handler. */
+	static SpeedrunBridge *create(ScummEngine *vm);
+	/** Writes an end record with reason "quit" unless the run already ended. */
+	~SpeedrunBridge();
+
+	/** go(), before the boot script runs: writes the boot record. */
+	void onBoot();
+	/**
+	 * First statement of scummLoop(): the previous frame has completed and
+	 * processInput() has not run yet. @p delta is the unclamped tick delta
+	 * (jiffies of 1/60 s).
+	 */
+	void onFrameBegin(int delta);
+	/** scummLoop(), right before checkAndRunSentenceScript(). */
+	void onDecisionPoint();
+	/** waitForTimer(): true skips the real-time wait (SPEEDRUN_FAST). */
+	bool skipWaits() const { return _skipWaits; }
+
+private:
+	explicit SpeedrunBridge(ScummEngine *vm);
+	SpeedrunBridge(const SpeedrunBridge &) = delete;
+	SpeedrunBridge &operator=(const SpeedrunBridge &) = delete;
+
+	void readEnv();
+	void validateEnv();
+
+	/** onFrameBegin, step 1: checks on the completed previous frame. */
+	void observePreviousFrame();
+	void neutraliseInput();
+	void pumpAudio(int delta);
+
+	/** End the run: end record, close the trace, quitGame(). Idempotent. */
+	void finish(const char *reason);
+	/** Error record with @p code, then finish("error"). */
+	void fail(const char *code, const Common::String &message);
+	/** Report through ScummVM's error(), which never returns; the error record gets @p code. */
+	void raiseError(const char *code, const Common::String &message);
+	/**
+	 * Write the optional error record and the end record, then close the trace.
+	 * Marks the run finished before writing. Returns false if it already was.
+	 */
+	bool endTrace(const char *reason, const char *errorCode, const char *errorMessage);
+	static bool errorHandler(const char *msg);
+
+	// Trace (contract C5): one JSON object per line, flushed after each
+	/** A record with "type", "tick" and "frame"; callers add the rest. */
+	JsonObject record(const char *type) const;
+	void writeRecord(const JsonObject &rec);
+	/** FNV-1a 32 over _scummVars[0.._numVariables) as little-endian int32s. */
+	Common::String varsFingerprint() const;
+
+	ScummEngine *_vm;
+
+	// Configuration (contract C1)
+	Common::String _outDir;
+	bool _skipWaits = false;
+	bool _pumpAudio = false;
+	bool _hasMaxTicks = false;
+	uint64 _maxTicks = 0;
+	bool _dumpObjects = false;
+	Common::String _planPath;
+	Common::String _startJson;      // raw JSON from SPEEDRUN_START
+	Common::String _goalJson;       // raw JSON from SPEEDRUN_GOAL
+	Common::String _inventoryJson;  // raw JSON from SPEEDRUN_INVENTORY
+	uint64 _stepTimeout = 36000;    // ticks; 10 minutes of game time
+	Common::String _envError;       // first invalid variable, reported once the trace is open
+
+	// Run clock (contract C2): ticks = sum of unclamped deltas since boot
+	uint64 _ticks = 0;
+	uint64 _frames = 0;
+
+	// Tick-locked audio (null mixer, --disable-sdl-audio)
+	static const uint kAudioChunkFrames = 512;
+	uint _audioRate = 0;            // mixer output rate, frames per second
+	uint _audioFrameBytes = 4;      // 16-bit stereo
+	uint64 _audioRemainder = 0;     // sub-frame remainder, in 1/60 frames
+	uint64 _audioPending = 0;       // whole frames owed to the mixer (< one chunk after pumping)
+	uint64 _audioPumped = 0;        // frames mixed so far
+	int16 _audioBuf[kAudioChunkFrames * 2];
+
+	Common::DumpFile _trace;
+	bool _traceWriteFailed = false;
+	const char *_errorCode = "engine_error"; // code for the next error() record
+	bool _finished = false;
+};
+
+} // End of namespace Scumm
+
+#endif
