+// Written into every boot record. The test harness also greps the binary for
+// "speedrun-bridge" to tell a patched build from a stock one.
+static const char kBridgeMarker[] = "speedrun-bridge v1";
+
+static const char kTraceName[] = "trace.jsonl";
+
+// The live bridge, for the error handler (a plain function pointer).
+static SpeedrunBridge *g_speedrunBridge = nullptr;
+
+// Empty counts as unset.
+static const char *envValue(const char *name) {
+	const char *value = getenv(name);
+	return (value && *value) ? value : nullptr;
+}
+
+static bool parseUint64(const char *s, uint64 &out) {
+	if (!s || !*s)
+		return false;
+	const uint64 maxValue = ~(uint64)0;
+	uint64 value = 0;
+	for (; *s; ++s) {
+		if (*s < '0' || *s > '9')
+			return false;
+		const uint64 digit = (uint64)(*s - '0');
+		if (value > (maxValue - digit) / 10)
+			return false;
+		value = value * 10 + digit;
+	}
+	out = value;
+	return true;
+}
+
+#pragma mark - JSON
+
+Common::String jsonString(const char *s) {
+	if (!s)
+		return "null";
+	Common::String out("\"");
+	// Unsigned, so bytes >= 0x80 are not mistaken for control characters.
+	for (const byte *p = (const byte *)s; *p; ++p) {
+		const byte c = *p;
+		switch (c) {
+		case '"':
+			out += "\\\"";
+			break;
+		case '\\':
+			out += "\\\\";
+			break;
+		case '\n':
+			out += "\\n";
+			break;
+		case '\r':
+			out += "\\r";
+			break;
+		case '\t':
+			out += "\\t";
+			break;
+		case '\b':
+			out += "\\b";
+			break;
+		case '\f':
+			out += "\\f";
+			break;
+		default:
+			if (c < 0x20 || c >= 0x7F)
+				out += Common::String::format("\\u%04x", (uint)c);
+			else
+				out += (char)c;
+			break;
+		}
+	}
+	out += '"';
+	return out;
+}
+
+JsonObject &JsonObject::addRaw(const char *key, const Common::String &json) {
+	if (!_members.empty())
+		_members += ',';
+	_members += jsonString(key);
+	_members += ':';
+	_members += json;
+	return *this;
+}
+
+JsonObject &JsonObject::add(const char *key, int value) {
+	return addRaw(key, Common::String::format("%d", value));
+}
+
+JsonObject &JsonObject::add(const char *key, uint value) {
+	return addRaw(key, Common::String::format("%u", value));
+}
+
+JsonObject &JsonObject::add(const char *key, int64 value) {
+	return addRaw(key, Common::String::format("%lld", (long long)value));
+}
+
+JsonObject &JsonObject::add(const char *key, uint64 value) {
+	return addRaw(key, Common::String::format("%llu", (unsigned long long)value));
+}
+
+JsonObject &JsonObject::add(const char *key, bool value) {
+	return addRaw(key, value ? "true" : "false");
+}
+
+JsonObject &JsonObject::add(const char *key, const char *value) {
+	return addRaw(key, jsonString(value));
+}
+
+JsonObject &JsonObject::add(const char *key, const Common::String &value) {
+	return addRaw(key, jsonString(value.c_str()));
+}
+
+JsonObject &JsonObject::addNull(const char *key) {
+	return addRaw(key, "null");
+}
+
+Common::String JsonObject::str() const {
+	return "{" + _members + "}";
+}
+
+JsonArray &JsonArray::addRaw(const Common::String &json) {
+	if (!_elements.empty())
+		_elements += ',';
+	_elements += json;
+	return *this;
+}
+
+JsonArray &JsonArray::add(int value) {
+	return addRaw(Common::String::format("%d", value));
+}
+
+Common::String JsonArray::str() const {
+	return "[" + _elements + "]";
+}
+
+#pragma mark - Lifetime
+
+SpeedrunBridge::SpeedrunBridge(ScummEngine *vm) : _vm(vm) {
+	memset(_audioBuf, 0, sizeof(_audioBuf));
+}
+
+SpeedrunBridge *SpeedrunBridge::create(ScummEngine *vm) {
+	const char *outDir = envValue("SPEEDRUN_OUT");
+	if (!outDir)
+		return nullptr;
+
+	SpeedrunBridge *bridge = new SpeedrunBridge(vm);
+	bridge->_outDir = outDir;
+	bridge->readEnv();
+
+	// Replace the engine's default error handler first: it attaches the GUI
+	// debugger, which blocks forever under SDL's dummy video driver.
+	g_speedrunBridge = bridge;
+	Common::setErrorHandler(errorHandler);
+
+	const Common::Path tracePath = Common::Path(bridge->_outDir, Common::Path::kNativeSeparator).appendComponent(kTraceName);
+	if (!bridge->_trace.open(tracePath, true))
+		error("speedrun: cannot open trace file '%s'", tracePath.toString(Common::Path::kNativeSeparator).c_str());
+
+	bridge->validateEnv();
+
+	// --disable-sdl-audio is stored in the transient ConfMan domain. Without
+	// it the backend's audio thread pulls the mixer, and we must not.
+	if (ConfMan.getBool("disable_sdl_audio")) {
+		Audio::Mixer *mixer = vm->_mixer;
+		bridge->_audioRate = mixer ? mixer->getOutputRate() : 0;
+		bridge->_audioFrameBytes = (mixer && mixer->getOutputStereo()) ? 4 : 2;
+		bridge->_pumpAudio = bridge->_audioRate > 0;
+	}
+
+	debug(1, "speedrun: %s active, out='%s' fast=%d audio_pump=%d rate=%u max_ticks=%s",
+	      kBridgeMarker, bridge->_outDir.c_str(), bridge->_skipWaits, bridge->_pumpAudio, bridge->_audioRate,
+	      bridge->_hasMaxTicks ? Common::String::format("%llu", (unsigned long long)bridge->_maxTicks).c_str() : "none");
+	return bridge;
+}
+
+void SpeedrunBridge::readEnv() {
+	// Booleans and integers are validated in validateEnv(), once the trace is
+	// open and an invalid value can be reported there.
+	const char *fast = envValue("SPEEDRUN_FAST");
+	if (fast && !Common::parseBool(fast, _skipWaits) && _envError.empty())
+		_envError = Common::String::format("invalid SPEEDRUN_FAST '%s'", fast);
+
+	const char *maxTicks = envValue("SPEEDRUN_MAX_TICKS");
+	if (maxTicks) {
+		_hasMaxTicks = parseUint64(maxTicks, _maxTicks);
+		if (!_hasMaxTicks && _envError.empty())
+			_envError = Common::String::format("invalid SPEEDRUN_MAX_TICKS '%s'", maxTicks);
+	}
+
+	const char *dumpObjects = envValue("SPEEDRUN_DUMP_OBJECTS");
+	if (dumpObjects && !Common::parseBool(dumpObjects, _dumpObjects) && _envError.empty())
+		_envError = Common::String::format("invalid SPEEDRUN_DUMP_OBJECTS '%s'", dumpObjects);
+
+	const char *stepTimeout = envValue("SPEEDRUN_STEP_TIMEOUT");
+	if (stepTimeout && !parseUint64(stepTimeout, _stepTimeout) && _envError.empty())
+		_envError = Common::String::format("invalid SPEEDRUN_STEP_TIMEOUT '%s'", stepTimeout);
+
+	// C3 condition lists; ranges are checked in onBoot(), once the game's
+	// variable and object counts are known.
+	static const struct {
+		const char *name;
+		SpeedrunConditions SpeedrunBridge::*list;
+	} kConditionVars[] = {
+		{"SPEEDRUN_START", &SpeedrunBridge::_start},
+		{"SPEEDRUN_GOAL", &SpeedrunBridge::_goal},
+	};
+	for (const auto &var : kConditionVars) {
+		const char *json = envValue(var.name);
+		Common::String error;
+		if (json && !parseSpeedrunConditions(json, this->*var.list, error) && _envError.empty())
+			_envError = Common::String::format("invalid %s: %s", var.name, error.c_str());
+	}
+
+	// Stored raw; parsed by the plan player.
+	const char *plan = envValue("SPEEDRUN_PLAN");
+	_planPath = plan ? plan : "";
+	const char *inventory = envValue("SPEEDRUN_INVENTORY");
+	_inventoryJson = inventory ? inventory : "";
+}
+
+void SpeedrunBridge::validateEnv() {
+	if (!_envError.empty())
+		raiseError("bad_env", _envError);
+}
+
+SpeedrunBridge::~SpeedrunBridge() {
+	// Still running here means the engine quit by itself (e.g. window closed).
+	endTrace("quit", nullptr, nullptr);
+	// The error handler deliberately stays installed (it returns true without
+	// a live bridge): ScummVM has no way to restore the engine's default
+	// handler, and a headless run must never get a message box or debugger.
+	if (g_speedrunBridge == this)
+		g_speedrunBridge = nullptr;
+}
+
+#pragma mark - Hooks
+
+void SpeedrunBridge::onBoot() {
+	if (_finished)
+		return;
+
+	checkConditionRanges(_start, "SPEEDRUN_START");
+	checkConditionRanges(_goal, "SPEEDRUN_GOAL");
+
+	JsonObject rec = record("boot");
+	rec.add("bridge", kBridgeMarker)
+	   .add("game", _vm->_game.gameid)
+	   .add("variant", _vm->_game.variant)
+	   .add("fast", _skipWaits)
+	   .add("audio_pump", _pumpAudio);
+	// --random-seed is stored in the session domain; Common::RandomSource uses
+	// it when the key exists (common/random.cpp).
+	if (ConfMan.hasKey("random_seed"))
+		rec.add("seed", ConfMan.getInt("random_seed"));
+	else
+		rec.addNull("seed");
+	rec.add("boot_param", _vm->_bootParam);
+	writeRecord(rec);
+
+	// A save slot from the command line makes go() load a game instead of
+	// running the boot script. Runs never load.
+	if (_vm->_saveLoadFlag != 0) {
+		const Common::String msg = Common::String::format("load requested at boot (flag %d, slot %d)", _vm->_saveLoadFlag, _vm->_saveLoadSlot);
+		_vm->_saveLoadFlag = 0;
+		fail("saveload", msg);
+	}
+}
+
+void SpeedrunBridge::onFrameBegin(int delta) {
+	if (_finished)
+		return;
+
+	// 1. Observe the completed previous frame. Records written here carry the
+	//    counters before this frame's delta (C2 stamping rule).
+	observePreviousFrame();
+	if (_finished)
+		return;
+
+	// 2. Advance the run clock to this frame.
+	if (delta > 0)
+		_ticks += (uint64)delta;
+	_frames++;
+
+	// 3. Prepare this frame: pin input, then let delta jiffies of audio play.
+	neutraliseInput();
+	if (_pumpAudio)
+		pumpAudio(delta);
+
+	// 4. Watchdog, stamped after the add.
+	if (_hasMaxTicks && _ticks >= _maxTicks) {
+		if (_dumpObjects)
+			fail("dump_not_reached", "max_ticks reached before the first idle frame; objects.json not written");
+		else
+			finish("max_ticks");
+	}
+}
+
+void SpeedrunBridge::observePreviousFrame() {
+	// Saving and loading are banned in runs (Alt/Ctrl+digit, autosave). Clear
+	// the request so scummLoop does not perform it on the way out.
+	if (_vm->_saveLoadFlag != 0) {
+		const Common::String msg = Common::String::format("save/load requested (flag %d, slot %d)", _vm->_saveLoadFlag, _vm->_saveLoadSlot);
+		_vm->_saveLoadFlag = 0;
+		fail("saveload", msg);
+		return;
+	}
+
+	// The goal is judged on the state after a whole frame: scripts, the
+	// sentence script, walking and room changes have all run.
+	if (_segmentStarted && !_goal.empty() && allHold(_goal)) {
+		reachGoal();
+		return;
+	}
+
+	maybeReportStall();
+}
+
+void SpeedrunBridge::onDecisionPoint() {
+	if (_finished)
+		return;
+
+	// Where checkExecVerbs() has just handled this frame's clicks, so idle
+	// here means "a click now would be taken in this frame".
+	_lastIdle = evaluateIdle();
+	if (_lastIdle.kind != kNotIdle) {
+		_idleSeenTick = _ticks;
+		_stallReported = false;
+	}
+
+	if (_dumpObjects) {
+		// The first idle frame of either kind: verbs exist and objects still
+		// have their game-start owners and states.
+		if (_lastIdle.kind != kNotIdle) {
+			writeFile("objects.json", objectsJson());
+			finish("dump_done");
+		}
+		return;
+	}
+
+	if (!_segmentStarted && _lastIdle.kind == kIdleSentence && allHold(_start))
+		startSegment();
+
+	// Plan steps hook in here (task 1.3).
+}
+
+#pragma mark - Run control
+
+void SpeedrunBridge::startSegment() {
+	_segmentStarted = true;
+	_tick0 = _ticks;
+	writeFile("state-start.json", stateJson());
+	writeRecord(record("segment_start").add("tick0", _tick0).add("room", (int)_vm->_currentRoom));
+}
+
+void SpeedrunBridge::reachGoal() {
+	writeFile("state-end.json", stateJson());
+	writeRecord(record("goal").add("ticks_from_start", _ticks - _tick0));
+	finish("goal");
+}
+
+void SpeedrunBridge::maybeReportStall() {
+	// Diagnostic only: name what kept the decision point from being idle once
+	// that has lasted kStallTicks, then again every kStallTicks.
+	static const uint64 kStallTicks = 3600; // one minute of game time
+	if (_lastIdle.kind != kNotIdle || !_lastIdle.blocker)
+		return;
+	const uint64 since = _stallReported ? _stallTick : _idleSeenTick;
+	if (_ticks - since < kStallTicks)
+		return;
+	JsonObject rec = record("stall");
+	rec.add("reason", _lastIdle.blocker);
+	if (_lastIdle.slot >= 0)
+		rec.add("slot", _lastIdle.slot).add("script", _lastIdle.script);
+	rec.add("room", (int)_vm->_currentRoom).add("not_idle_ticks", _ticks - _idleSeenTick);
+	writeRecord(rec);
+	_stallTick = _ticks;
+	_stallReported = true;
+}
+
+bool SpeedrunBridge::writeFile(const char *name, const Common::String &contents) {
+	const Common::Path path = Common::Path(_outDir, Common::Path::kNativeSeparator).appendComponent(name);
+	Common::DumpFile file;
+	bool ok = file.open(path, true);
+	if (ok) {
+		file.writeString(contents);
+		file.writeByte('\n');
+		ok = file.flush() && !file.err();
+		file.close();
+	}
+	if (!ok)
+		raiseError("engine_error", Common::String::format("cannot write %s in '%s'", name, _outDir.c_str()));
+	return ok;
+}
+
+#pragma mark - Infrastructure
+
+void SpeedrunBridge::neutraliseInput() {
+	// Undo everything parseEvents() may have written since the last frame, so
+	// a visible run is tick-identical to a headless one. processInput()
+	// derives _virtualMouse and _mouseAndKeyboardStat from these.
+	_vm->_mouse.x = 0;
+	_vm->_mouse.y = 0;
+	_vm->_leftBtnPressed = 0;
+	_vm->_rightBtnPressed = 0;
+	_vm->_keyPressed.reset();
+	_vm->_fastMode = 0;
+}
+
+void SpeedrunBridge::pumpAudio(int delta) {
+	if (delta <= 0)
+		return;
+
+	// Frames owed for delta jiffies of 1/60 s, exact over the whole run.
+	const uint64 owed = (uint64)delta * _audioRate + _audioRemainder;
+	_audioPending += owed / 60;
+	_audioRemainder = owed % 60;
+
+	// Fixed-size calls: the stream sees the same buffer sizes whatever the
+	// frame pacing; leftover frames wait for the next frame.
+	// The cast is valid: every backend mixer manager, the null one included,
+	// creates an Audio::MixerImpl.
+	Audio::MixerImpl *mixer = static_cast<Audio::MixerImpl *>(_vm->_mixer);
+	const uint chunkBytes = kAudioChunkFrames * _audioFrameBytes;
+	while (_audioPending >= kAudioChunkFrames) {
+		mixer->mixCallback((byte *)_audioBuf, chunkBytes);
+		_audioPending -= kAudioChunkFrames;
+		_audioPumped += kAudioChunkFrames;
+	}
+}
+
+void SpeedrunBridge::finish(const char *reason) {
+	if (endTrace(reason, nullptr, nullptr))
+		_vm->quitGame();
+}
+
+void SpeedrunBridge::fail(const char *code, const Common::String &message) {
+	if (endTrace("error", code, message.c_str()))
+		_vm->quitGame();
+}
+
+void SpeedrunBridge::raiseError(const char *code, const Common::String &message) {
+	_errorCode = code;
+	error("speedrun: %s", message.c_str());
+}
+
+bool SpeedrunBridge::endTrace(const char *reason, const char *errorCode, const char *errorMessage) {
+	if (_finished)
+		return false;
+	// Set first: nothing is written after the end record, even if writing
+	// it re-enters through error().
+	_finished = true;
+
+	if (errorCode) {
+		JsonObject err = record("error");
+		err.add("code", errorCode).add("message", errorMessage);
+		writeRecord(err);
+	}
+
+	// Fingerprint of the final state; determinism tests compare whole end
+	// records. Vars may not exist yet if error() fires during init().
+	const bool haveVars = _vm->_scummVars != nullptr;
+	JsonObject end = record("end");
+	end.add("reason", reason)
+	   .add("room", (int)_vm->_currentRoom)
+	   .add("audio_frames", _audioPumped);
+	if (haveVars && _vm->VAR_MUSIC_TIMER != 0xFF)
+		end.add("music_timer", (int)_vm->_scummVars[_vm->VAR_MUSIC_TIMER]);
+	else
+		end.addNull("music_timer");
+	if (haveVars)
+		end.add("vars_fnv1a", varsFingerprint());
+	else
+		end.addNull("vars_fnv1a");
+	writeRecord(end);
+	_trace.close();
+
+	debug(1, "speedrun: %s", end.str().c_str());
+	return true;
+}
+
+bool SpeedrunBridge::errorHandler(const char *msg) {
+	// Not synchronised with the main thread. That is fine for runs: with
+	// --disable-sdl-audio the mixer runs on the main thread (pumpAudio), so
+	// error() can only come from the main thread.
+	SpeedrunBridge *bridge = g_speedrunBridge;
+	if (bridge) {
+		// error() appends "!\n"; the newline is noise in a JSON string.
+		Common::String text(msg ? msg : "");
+		while (!text.empty() && (text.lastChar() == '\n' || text.lastChar() == '\r'))
+			text.deleteLastChar();
+		bridge->endTrace("error", bridge->_errorCode, text.c_str());
+	}
+	// Always handled, even after the bridge is gone: the message already went
+	// to the log, and a message box or the debugger would block a headless
+	// run. error() then exits.
+	return true;
+}
+
+#pragma mark - Trace
+
+JsonObject SpeedrunBridge::record(const char *type) const {
+	JsonObject rec;
+	rec.add("type", type).add("tick", _ticks).add("frame", _frames);
+	return rec;
+}
+
+void SpeedrunBridge::writeRecord(const JsonObject &rec) {
+	if (!_trace.isOpen())
+		return;
+	_trace.writeString(rec.str());
+	_trace.writeByte('\n');
+	const bool flushed = _trace.flush();
+	if ((!flushed || _trace.err()) && !_traceWriteFailed) {
+		_traceWriteFailed = true;
+		warning("speedrun: cannot write to %s in '%s'", kTraceName, _outDir.c_str());
+	}
+}
+
+Common::String SpeedrunBridge::varsFingerprint() const {
+	uint32 hash = 2166136261u; // FNV-1a 32 offset basis
+	for (int i = 0; i < _vm->_numVariables; i++) {
+		const uint32 value = (uint32)_vm->_scummVars[i];
+		for (int shift = 0; shift < 32; shift += 8) {
+			hash ^= (value >> shift) & 0xFF;
+			hash *= 16777619u; // FNV prime
+		}
+	}
+	return Common::String::format("%08x", hash);
+}
+
+} // End of namespace Scumm
