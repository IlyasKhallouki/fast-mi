+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ */
+
+// The plan player (docs/plan.md contract C4): loads SPEEDRUN_PLAN (parsed in
+// speedrun_plan_parser.cpp) and replays its steps at the decision point,
+// through the engine's own entry points: doSentence() for sentences,
+// runInputScript(kVerbClickArea, verb, 1) for verb and dialogue clicks (what
+// checkExecVerbs() calls for a real click).
+
+#include "common/algorithm.h"
+#include "common/fs.h"
+#include "common/stream.h"
+
+#include "scumm/object.h"
+#include "scumm/scumm.h"
+#include "scumm/verbs.h"
+#include "scumm/speedrun/speedrun_bridge.h"
+
+namespace Scumm {
+
+namespace {
+
+// Dialogue choices are verbs 120..128 (see speedrun_state.cpp).
+const int kDialogVerbFirst = 120, kDialogVerbLast = 128;
+// Consecutive idle decision points a step needs before it starts. 1: the
+// first idle frame, as early as a human could click (research §5).
+const int kIdleStreakRequired = 1;
+
+bool isNoisyVar(int var) {
+	// Engine-written every frame or wall-clock/mouse derived: camera, have-msg
+	// copy, timers, music timer, mouse, last sound, userput (docs/plan.md 1.3).
+	return var == 2 || var == 3 || (var >= 11 && var <= 14) || (var >= 20 && var <= 23) ||
+	       (var >= 44 && var <= 47) || var == 53;
+}
+
+// A step without a sentence or clicks only answers a menu the game opens.
+bool isDialogOnly(const SpeedrunStep &st) {
+	return !st.hasVerb && st.clicks.empty();
+}
+
+// The tail of a step_timeout message: the blocker as stall records name it.
+Common::String blockedBy(const char *blocker) {
+	return blocker ? Common::String("blocked by ") + blocker : Common::String("not blocked at the deadline");
+}
+
+Common::String asciiLower(const Common::String &s) {
+	Common::String out;
+	for (uint i = 0; i < s.size(); i++) {
+		const char c = s[i];
+		out += (c >= 'A' && c <= 'Z') ? (char)(c - 'A' + 'a') : c;
+	}
+	return out;
+}
+
+} // End of anonymous namespace
+
+#pragma mark - Loading
+
+void SpeedrunBridge::loadPlan() {
+	const Common::FSNode node(Common::Path(_planPath, Common::Path::kNativeSeparator));
+	Common::SeekableReadStream *stream = node.createReadStream();
+	if (!stream)
+		raiseError("bad_plan", Common::String::format("cannot read SPEEDRUN_PLAN '%s'", _planPath.c_str()));
+	const Common::String text = stream->readString(0, (uint32)stream->size());
+	delete stream;
+
+	// Parsed and checked into a local array, committed only once valid: until
+	// then errorStep() is -1, so a load error names no step in its record
+	// (its message does).
+	Common::Array<SpeedrunStep> plan;
+	Common::String error;
+	if (!parseSpeedrunPlan(text, plan, error))
+		raiseError("bad_plan", Common::String::format("SPEEDRUN_PLAN '%s': %s", _planPath.c_str(), error.c_str()));
+
+	// Ranges need the game's counts, known from init() on.
+	for (uint i = 0; i < plan.size(); i++) {
+		const SpeedrunStep &st = plan[i];
+		const Common::String where = Common::String::format("step %u (%s)", i, st.action.c_str());
+		const int32 objs[] = {st.hasVerb ? st.obj : 1, st.obj2};
+		for (int32 o : objs) {
+			if (o < 0 || o >= _vm->_numGlobalObjects)
+				raiseError("bad_plan", Common::String::format("%s: object %d out of range", where.c_str(), o));
+		}
+		if (st.hasVerb && (st.verb <= 0 || st.verb > 0xFF || st.obj == 0))
+			raiseError("bad_plan", Common::String::format("%s: sentence needs a verb 1..255 and an object", where.c_str()));
+		for (uint k = 0; k < st.clicks.size(); k++) {
+			const SpeedrunClick &c = st.clicks[k];
+			if (c.inventory && !_inventory.valid)
+				raiseError("bad_plan", Common::String::format("%s: inventory click needs SPEEDRUN_INVENTORY", where.c_str()));
+			if (c.inventory ? (c.value <= 0 || c.value >= _vm->_numGlobalObjects) : (c.value <= 0 || c.value > 0xFFFF))
+				raiseError("bad_plan", Common::String::format("%s: click %u target %d out of range", where.c_str(), k, c.value));
+		}
+		checkConditionRanges(st.until, (where + " until").c_str(), "bad_plan");
+	}
+	_plan.swap(plan);
+	_stepIndex = 0;
+	_stepWaitSince = 0;
+}
+
+#pragma mark - Execution
+
+void SpeedrunBridge::runPlan() {
+	// One engine action (push, click or answer) per decision point: each
+	// must be seen by checkAndRunSentenceScript() and the next frame first.
+	const IdleKind kind = _lastIdle.kind;
+	if (kind != kIdleDialog)
+		_menuAnswered = false;
+
+	if (_stepActive) {
+		const SpeedrunStep &st = _plan[_stepIndex];
+		const char *blocker = activeStepBlocker();
+		if (_ticks - _stepStartTick >= _stepTimeout) {
+			fail("step_timeout", Common::String::format(
+				"step %u (%s) did not complete within %llu ticks: clicks %u/%u, choices %u/%u, %s",
+				_stepIndex, st.action.c_str(), (unsigned long long)_stepTimeout, _clickIndex, st.clicks.size(),
+				_chooseIndex, st.choose.size(), blockedBy(blocker).c_str()));
+			return;
+		}
+		if (kind == kNotIdle)
+			return; // the idle blocker, with its script slot, is already set
+		if (blocker) {
+			setBlocker(blocker);
+			return;
+		}
+		if (kind == kIdleDialog) {
+			answerChoice();
+			return;
+		}
+		if (_clickIndex < st.clicks.size()) {
+			performClick();
+			return;
+		}
+		// Sentence-idle after the push frame: the queue has drained, so the
+		// sentence (and anything it queued) ran.
+		completeStep();
+	}
+
+	if (_planDone) {
+		if (kind == kIdleDialog)
+			fail("unexpected_choice", "dialogue menu after the last step: " + visibleChoices());
+		return;
+	}
+	tryStartStep();
+}
+
+bool SpeedrunBridge::tryStartStep() {
+	const SpeedrunStep &st = _plan[_stepIndex];
+	const IdleKind kind = _lastIdle.kind;
+	const char *blocker = pendingStepBlocker();
+
+	// The waiting time counts from the later of the previous step's end and
+	// the segment start; before the segment starts, max_ticks is the cap.
+	if (_segmentStarted) {
+		const uint64 since = MAX(_stepWaitSince, _tick0);
+		if (_ticks - since >= _stepTimeout) {
+			fail("step_timeout", Common::String::format(
+				"step %u (%s) could not start within %llu ticks: %s", _stepIndex, st.action.c_str(),
+				(unsigned long long)_stepTimeout, blockedBy(blocker).c_str()));
+			return false;
+		}
+	}
+
+	if (kind == kIdleDialog && !isDialogOnly(st)) {
+		fail("unexpected_choice", Common::String::format("dialogue menu before step %u (%s), which does not answer one: %s",
+		                                                 _stepIndex, st.action.c_str(), visibleChoices().c_str()));
+		return false;
+	}
+	if (kind == kNotIdle)
+		return false; // the idle blocker, with its script slot, is already set
+	if (blocker) {
+		setBlocker(blocker);
+		return false;
+	}
+	if (_idleStreak < kIdleStreakRequired)
+		return false;
+	startStep();
+	return true;
+}
+
+const char *SpeedrunBridge::activeStepBlocker() const {
+	// What keeps the active step from acting at this decision point, named
+	// as the stall records name it; nullptr if it clicks, answers or ends.
+	const SpeedrunStep &st = _plan[_stepIndex];
+	switch (_lastIdle.kind) {
+	case kNotIdle:
+		return _lastIdle.blocker;
+	case kIdleDialog:
+		// An answered menu has to go away before the next one is answered.
+		return _menuAnswered ? "menu_answered" : nullptr;
+	case kIdleSentence:
+		// The sentence ran, but the menu this step answers has not come up.
+		return (_clickIndex >= st.clicks.size() && _chooseIndex < st.choose.size()) ? "awaiting_menu" : nullptr;
+	}
+	return nullptr;
+}
+
+const char *SpeedrunBridge::pendingStepBlocker() const {
+	// What keeps the next step from starting at this decision point, named
+	// as the stall records name it; nullptr if it may start. The step's
+	// `until` is only evaluated once the idle kind is right.
+	const SpeedrunStep &st = _plan[_stepIndex];
+	const bool dialogOnly = isDialogOnly(st);
+	const IdleKind kind = _lastIdle.kind;
+	if (kind == kNotIdle)
+		return _lastIdle.blocker;
+	if (kind != (dialogOnly ? kIdleDialog : kIdleSentence))
+		return dialogOnly ? "awaiting_menu" : "dialog";
+	return allHold(st.until) ? nullptr : "until";
+}
+
+void SpeedrunBridge::startStep() {
+	const SpeedrunStep &st = _plan[_stepIndex];
+	ScummEngine &e = *_vm;
+
+	if (st.hasRoom && e._currentRoom != st.room) {
+		fail("room_mismatch", Common::String::format("expected room %d, ego in %d", st.room, e._currentRoom));
+		return;
+	}
+	if (st.hasVerb) {
+		// A scene click can never select an untouchable object (findObject()
+		// skips class 32), so neither may a pushed sentence. Exempt: actors,
+		// and ego's inventory, which is clicked through the slot verbs and
+		// Var[133+k], never findObject() (global/script-004.txt [0304]-[0345]);
+		// MI1 inventory items often carry class 32 (e.g. the meat once used).
+		const int32 objs[] = {st.obj, st.obj2};
+		const int ego = e._scummVars[e.VAR_EGO];
+		for (int32 o : objs) {
+			if (o >= e._numActors && e._objectOwnerTable[o] != ego &&
+			    (e._classData[o] & (1u << (kObjectClassUntouchable - 1)))) {
+				fail("untouchable_target", Common::String::format("object %d is untouchable (class %d) at step start", o, (int)kObjectClassUntouchable));
+				return;
+			}
+		}
+	}
+
+	takeSnapshot();
+	JsonObject rec = record("step_start");
+	rec.add("step", (int)_stepIndex).add("action", st.action).add("room", (int)e._currentRoom);
+	if (st.hasVerb)
+		rec.addRaw("sentence", JsonArray().add(st.verb).add(st.obj).add(st.obj2).str());
+	writeRecord(rec);
+
+	_stepActive = true;
+	_stepStartTick = _ticks;
+	_clickIndex = 0;
+	_chooseIndex = 0;
+	markProgress();
+
+	if (st.hasVerb) {
+		e.doSentence(st.verb, st.obj, st.obj2); // sentence-idle: _sentenceNum is 0
+	} else if (!st.clicks.empty()) {
+		performClick();
+	} else {
+		answerChoice();
+	}
+}
+
+void SpeedrunBridge::completeStep() {
+	JsonObject rec = record("step_end");
+	rec.add("step", (int)_stepIndex)
+	   .add("room", (int)_vm->_currentRoom)
+	   .add("ticks", _ticks - _stepStartTick)
+	   .addRaw("changes", changesJson());
+	writeRecord(rec);
+
+	_stepActive = false;
+	_stepIndex++;
+	_stepWaitSince = _ticks;
+	markProgress();
+	if (_stepIndex >= _plan.size()) {
+		_planDone = true;
+		_planDoneTick = _ticks;
+	}
+}
+
+void SpeedrunBridge::performClick() {
+	const SpeedrunStep &st = _plan[_stepIndex];
+	const SpeedrunClick &c = st.clicks[_clickIndex];
+	ScummEngine &e = *_vm;
+
+	int slotOf = -1; // slot of the verb to click
+	int verbId = c.value;
+	if (c.inventory) {
+		// The slot showing object c.value: verb verbFirst+k is visible and
+		// Var[varFirst+k] holds the object (global/script-009.txt [0092]).
+		int k = -1;
+		for (int i = 0; i < _inventory.count && k < 0; i++) {
+			const int vid = _inventory.verbFirst + i;
+			for (int slot = 1; slot < e._numVerbs && k < 0; slot++) {
+				if (e._verbs[slot].verbid == vid && verbVisible(slot) && e._scummVars[_inventory.varFirst + i] == c.value)
+					k = i;
+			}
+		}
+		if (k < 0) {
+			fail("click_target_missing", Common::String::format("click %u: object %d is in no visible inventory slot", _clickIndex, c.value));
+			return;
+		}
+		// The offset must stay inside the slot layout: next to it are other
+		// verbs, e.g. the scroll arrows 208/209 (global/script-009.txt [00FB], [0120]).
+		const int64 target = (int64)k + c.offset;
+		if (target < 0 || target >= _inventory.count) {
+			fail("click_target_missing", Common::String::format(
+				"click %u: offset %d from object %d's slot %d is outside the %d inventory slots",
+				_clickIndex, c.offset, c.value, k, _inventory.count));
+			return;
+		}
+		verbId = _inventory.verbFirst + (int)target;
+	}
+	for (int slot = 1; slot < e._numVerbs && slotOf < 0; slot++) {
+		if (e._verbs[slot].verbid == verbId && verbVisible(slot))
+			slotOf = slot;
+	}
+	if (slotOf < 0) {
+		fail("click_target_missing", Common::String::format("click %u: verb %d is not a visible verb slot", _clickIndex, verbId));
+		return;
+	}
+
+	e.runInputScript(kVerbClickArea, verbId, 1); // what checkExecVerbs() runs for a left click
+	JsonObject rec = record("click");
+	rec.add("step", (int)_stepIndex).add("verb_id", verbId).add("slot", slotOf);
+	if (c.inventory)
+		rec.add("inventory", c.value).add("offset", c.offset);
+	writeRecord(rec);
+	_clickIndex++;
+	markProgress();
+}
+
+void SpeedrunBridge::answerChoice() {
+	const SpeedrunStep &st = _plan[_stepIndex];
+	if (_chooseIndex >= st.choose.size()) {
+		fail("unexpected_choice", Common::String::format("step %u (%s) has no choose entry left for this menu: %s",
+		                                                 _stepIndex, st.action.c_str(), visibleChoices().c_str()));
+		return;
+	}
+	const Common::String needle = asciiLower(st.choose[_chooseIndex]);
+	int match = -1, matches = 0;
+	Common::String matchText;
+	for (int slot = 1; slot < _vm->_numVerbs; slot++) {
+		const int id = _vm->_verbs[slot].verbid;
+		Common::String text;
+		if (id < kDialogVerbFirst || id > kDialogVerbLast || !verbVisible(slot) || !verbText(slot, true, text))
+			continue;
+		if (asciiLower(text).contains(needle)) {
+			matches++;
+			match = id;
+			matchText = text;
+		}
+	}
+	if (matches == 0) {
+		fail("choice_not_found", Common::String::format("no visible choice contains \"%s\"; visible: %s",
+		                                                st.choose[_chooseIndex].c_str(), visibleChoices().c_str()));
+		return;
+	}
+	if (matches > 1) {
+		fail("choice_ambiguous", Common::String::format("\"%s\" matches %d visible choices: %s",
+		                                                st.choose[_chooseIndex].c_str(), matches, visibleChoices().c_str()));
+		return;
+	}
+
+	_vm->runInputScript(kVerbClickArea, match, 1);
+	JsonObject rec = record("choice");
+	rec.add("step", (int)_stepIndex).add("verb_id", match).add("text", matchText);
+	writeRecord(rec);
+	_chooseIndex++;
+	_menuAnswered = true; // the next answer needs a new menu
+	markProgress();
+}
+
+Common::String SpeedrunBridge::visibleChoices() const {
+	Common::String out;
+	for (int id = kDialogVerbFirst; id <= kDialogVerbLast; id++) {
+		for (int slot = 1; slot < _vm->_numVerbs; slot++) {
+			Common::String text;
+			if (_vm->_verbs[slot].verbid != id || !verbVisible(slot) || !verbText(slot, true, text))
+				continue;
+			out += Common::String::format("%s%d: \"%s\"", out.empty() ? "" : "; ", id, text.c_str());
+		}
+	}
+	return out.empty() ? Common::String("(none)") : out;
+}
+
+#pragma mark - Step changes
+
+void SpeedrunBridge::takeSnapshot() {
+	const ScummEngine &e = *_vm;
+	_snapVars.resize(e._numVariables);
+	for (int i = 0; i < e._numVariables; i++)
+		_snapVars[i] = e._scummVars[i];
+	const int bitBytes = (e._numBitVariables + 7) / 8;
+	_snapBits.resize(bitBytes);
+	for (int i = 0; i < bitBytes; i++)
+		_snapBits[i] = e._bitVars[i];
+	_snapInventory = egoInventory();
+	_snapRoom = e._currentRoom;
+}
+
+Common::String SpeedrunBridge::changesJson() const {
+	const ScummEngine &e = *_vm;
+	JsonObject vars, bits;
+	for (int i = 0; i < e._numVariables && i < (int)_snapVars.size(); i++) {
+		if (!isNoisyVar(i) && _snapVars[i] != e._scummVars[i])
+			vars.addRaw(Common::String::format("%d", i).c_str(), JsonArray().add(_snapVars[i]).add(e._scummVars[i]).str());
+	}
+	for (int n = 0; n < e._numBitVariables && (n >> 3) < (int)_snapBits.size(); n++) {
+		const int before = (_snapBits[n >> 3] >> (n & 7)) & 1;
+		const int after = (e._bitVars[n >> 3] >> (n & 7)) & 1;
+		if (before != after)
+			bits.addRaw(Common::String::format("%d", n).c_str(), JsonArray().add(before).add(after).str());
+	}
+	const Common::Array<int> now = egoInventory();
+	JsonArray added, removed;
+	for (uint i = 0; i < now.size(); i++) {
+		if (Common::find(_snapInventory.begin(), _snapInventory.end(), now[i]) == _snapInventory.end())
+			added.add(now[i]);
+	}
+	for (uint i = 0; i < _snapInventory.size(); i++) {
+		if (Common::find(now.begin(), now.end(), _snapInventory[i]) == now.end())
+			removed.add(_snapInventory[i]);
+	}
+	JsonObject changes;
+	changes.addRaw("vars", vars.str()).addRaw("bits", bits.str());
+	changes.addRaw("inventory", JsonObject().addRaw("added", added.str()).addRaw("removed", removed.str()).str());
+	if (_snapRoom != e._currentRoom)
+		changes.addRaw("room", JsonArray().add(_snapRoom).add((int)e._currentRoom).str());
+	return changes.str();
+}
+
+} // End of namespace Scumm
