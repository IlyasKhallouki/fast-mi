+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ */
+
+// C3 conditions (docs/plan.md): parsing, range checks and evaluation.
+
+#include "common/formats/json.h"
+
+#include "scumm/actor.h"
+#include "scumm/scumm.h"
+#include "scumm/speedrun/speedrun_bridge.h"
+
+namespace Scumm {
+
+namespace {
+
+// SCUMM v5 MI1: object ids 1..12 are actors (src/speedrun/conditions.py MAX_ACTOR).
+const int kMaxActor = 12;
+
+bool readInt(const Common::JSONValue *value, int32 &out) {
+	if (!value || !value->isIntegerNumber())
+		return false; // rejects bools, strings and 1.5 alike
+	const long long v = value->asIntegerNumber();
+	if (v < -2147483647LL - 1 || v > 2147483647LL)
+		return false;
+	out = (int32)v;
+	return true;
+}
+
+bool hasExactKeys(const Common::JSONObject &obj, const char *a, const char *b = nullptr) {
+	if (obj.size() != (b ? 2u : 1u))
+		return false;
+	return obj.contains(a) && (!b || obj.contains(b));
+}
+
+bool parseCondition(const Common::JSONValue *value, SpeedrunCondition &cond, Common::String &error) {
+	if (!value || !value->isObject()) {
+		error = "a condition must be a JSON object";
+		return false;
+	}
+	const Common::JSONObject &obj = value->asObject();
+
+	if (hasExactKeys(obj, "not")) {
+		if (!parseCondition(obj.getVal("not"), cond, error)) {
+			error = "in 'not': " + error;
+			return false;
+		}
+		cond.negate = !cond.negate;
+		return true;
+	}
+
+	cond.negate = false;
+	cond.op = SpeedrunCondition::kEq;
+	cond.value = 0;
+
+	static const struct {
+		const char *key;
+		SpeedrunCondition::Kind kind;
+	} kCompare[] = {
+		{"var", SpeedrunCondition::kVar},
+		{"bit", SpeedrunCondition::kBit},
+		{"owner", SpeedrunCondition::kOwner},
+		{"state", SpeedrunCondition::kState},
+		{"actor_room", SpeedrunCondition::kActorRoom},
+	};
+	for (const auto &form : kCompare) {
+		if (hasExactKeys(obj, form.key, "eq")) {
+			cond.kind = form.kind;
+			if (!readInt(obj.getVal(form.key), cond.subject) || !readInt(obj.getVal("eq"), cond.value)) {
+				error = Common::String::format("'%s' and 'eq' must be integers", form.key);
+				return false;
+			}
+			if (cond.kind == SpeedrunCondition::kActorRoom && (cond.subject < 1 || cond.subject > kMaxActor)) {
+				error = Common::String::format("'actor_room' must be an actor id 1..%d", kMaxActor);
+				return false;
+			}
+			return true;
+		}
+	}
+
+	static const struct {
+		const char *key;
+		SpeedrunCondition::Kind kind;
+	} kUnary[] = {
+		{"room", SpeedrunCondition::kRoom},
+		{"has", SpeedrunCondition::kHas},
+	};
+	for (const auto &form : kUnary) {
+		if (hasExactKeys(obj, form.key)) {
+			cond.kind = form.kind;
+			if (!readInt(obj.getVal(form.key), cond.subject)) {
+				error = Common::String::format("'%s' must be an integer", form.key);
+				return false;
+			}
+			return true;
+		}
+	}
+
+	static const struct {
+		const char *key;
+		SpeedrunCondition::Kind kind;
+	} kPosition[] = {
+		{"actor_x", SpeedrunCondition::kActorX},
+		{"actor_y", SpeedrunCondition::kActorY},
+	};
+	static const struct {
+		const char *key;
+		SpeedrunCondition::Op op;
+	} kOps[] = {
+		{"eq", SpeedrunCondition::kEq},
+		{"le", SpeedrunCondition::kLe},
+		{"ge", SpeedrunCondition::kGe},
+	};
+	for (const auto &form : kPosition) {
+		for (const auto &op : kOps) {
+			if (hasExactKeys(obj, form.key, op.key)) {
+				cond.kind = form.kind;
+				cond.op = op.op;
+				if (!readInt(obj.getVal(form.key), cond.subject) || !readInt(obj.getVal(op.key), cond.value)) {
+					error = Common::String::format("'%s' and '%s' must be integers", form.key, op.key);
+					return false;
+				}
+				if (cond.subject < 1 || cond.subject > kMaxActor) {
+					error = Common::String::format("'%s' must be an actor id 1..%d", form.key, kMaxActor);
+					return false;
+				}
+				return true;
+			}
+		}
+	}
+
+	error = "unknown condition; expected {var|bit|owner|state: int, eq: int}, {room: int}, {has: int}, "
+	        "{actor_room: actor, eq: int}, {actor_x|actor_y: actor, eq|le|ge: int} or {not: condition}";
+	return false;
+}
+
+} // End of anonymous namespace
+
+bool parseSpeedrunConditions(const Common::String &json, SpeedrunConditions &out, Common::String &error) {
+	out.clear();
+	Common::JSONValue *root = Common::JSON::parse(json);
+	if (!root) {
+		error = "not valid JSON";
+		return false;
+	}
+	bool ok = true;
+	if (!root->isArray()) {
+		error = "expected a JSON array of conditions";
+		ok = false;
+	} else {
+		const Common::JSONArray &items = root->asArray();
+		for (uint i = 0; ok && i < items.size(); i++) {
+			SpeedrunCondition cond;
+			if (!parseCondition(items[i], cond, error)) {
+				error = Common::String::format("condition %u: %s", i, error.c_str());
+				ok = false;
+			} else {
+				out.push_back(cond);
+			}
+		}
+	}
+	delete root;
+	if (!ok)
+		out.clear();
+	return ok;
+}
+
+void SpeedrunBridge::checkConditionRanges(const SpeedrunConditions &conds, const char *envName) {
+	for (uint i = 0; i < conds.size(); i++) {
+		const SpeedrunCondition &c = conds[i];
+		int limit = -1;
+		const char *what = nullptr;
+		switch (c.kind) {
+		case SpeedrunCondition::kVar:
+			limit = _vm->_numVariables;
+			what = "variable";
+			break;
+		case SpeedrunCondition::kBit:
+			limit = _vm->_numBitVariables;
+			what = "bit variable";
+			break;
+		case SpeedrunCondition::kOwner:
+		case SpeedrunCondition::kState:
+		case SpeedrunCondition::kHas:
+			limit = _vm->_numGlobalObjects;
+			what = "object";
+			break;
+		case SpeedrunCondition::kActorRoom:
+		case SpeedrunCondition::kActorX:
+		case SpeedrunCondition::kActorY:
+			limit = _vm->_numActors;
+			what = "actor";
+			break;
+		case SpeedrunCondition::kRoom:
+			break;
+		}
+		if (what && (c.subject < 0 || c.subject >= limit))
+			raiseError("bad_env", Common::String::format("%s condition %u: %s %d out of range 0..%d", envName, i, what, c.subject, limit - 1));
+	}
+}
+
+bool SpeedrunBridge::conditionHolds(const SpeedrunCondition &c) const {
+	const ScummEngine &e = *_vm;
+	int32 actual = 0;
+	bool result = false;
+
+	switch (c.kind) {
+	case SpeedrunCondition::kVar:
+		actual = e._scummVars[c.subject];
+		break;
+	case SpeedrunCondition::kBit:
+		// readVar(0x8000 | n): bit n is _bitVars[n >> 3] & (1 << (n & 7)) (script.cpp)
+		actual = (e._bitVars[c.subject >> 3] & (1 << (c.subject & 7))) ? 1 : 0;
+		break;
+	case SpeedrunCondition::kRoom:
+		actual = e._currentRoom;
+		break;
+	case SpeedrunCondition::kOwner:
+		actual = e._objectOwnerTable[c.subject];
+		break;
+	case SpeedrunCondition::kState:
+		actual = e._objectStateTable[c.subject];
+		break;
+	case SpeedrunCondition::kHas: {
+		// Ego's inventory, as findInventory()/getInventoryCount() see it.
+		const int ego = e._scummVars[e.VAR_EGO];
+		for (int i = 0; i < e._numInventory && !result; i++)
+			result = e._inventory[i] == c.subject && ego > 0 && e._objectOwnerTable[c.subject] == ego;
+		return result != c.negate;
+	}
+	case SpeedrunCondition::kActorRoom:
+	case SpeedrunCondition::kActorX:
+	case SpeedrunCondition::kActorY: {
+		const Actor *a = e._actors[c.subject];
+		if (c.kind == SpeedrunCondition::kActorRoom)
+			actual = a->_room;
+		else if (c.kind == SpeedrunCondition::kActorX)
+			actual = a->getRealPos().x;
+		else
+			actual = a->getRealPos().y;
+		break;
+	}
+	}
+
+	switch (c.kind) {
+	case SpeedrunCondition::kRoom:
+		result = actual == c.subject;
+		break;
+	default:
+		if (c.op == SpeedrunCondition::kLe)
+			result = actual <= c.value;
+		else if (c.op == SpeedrunCondition::kGe)
+			result = actual >= c.value;
+		else
+			result = actual == c.value;
+		break;
+	}
+	return result != c.negate;
+}
+
+bool SpeedrunBridge::allHold(const SpeedrunConditions &conds) const {
+	for (uint i = 0; i < conds.size(); i++) {
+		if (!conditionHolds(conds[i]))
+			return false;
+	}
+	return true;
+}
+
+} // End of namespace Scumm
