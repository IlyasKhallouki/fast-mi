+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ */
+
+#ifndef SCUMM_SPEEDRUN_SPEEDRUN_JSON_H
+#define SCUMM_SPEEDRUN_SPEEDRUN_JSON_H
+
+// JSON output for the speedrun bridge: builders for the trace records and
+// dumps, the JSON Lines trace file, and whole-file dumps.
+
+#include "common/scummsys.h"
+#include "common/file.h"
+#include "common/path.h"
+#include "common/str.h"
+
+namespace Common {
+class FSNode;
+}
+
+namespace Scumm {
+
+/**
+ * JSON string literal, pure ASCII: escapes quotes, backslashes and control
+ * characters; bytes >= 0x80 become \u00XX (the byte read as Latin-1).
+ * nullptr gives null.
+ */
+Common::String jsonString(const char *s);
+
+/** Builds one JSON object; members appear in the order they are added. */
+class JsonObject {
+public:
+	JsonObject &add(const char *key, int value);
+	JsonObject &add(const char *key, uint value);
+	JsonObject &add(const char *key, int64 value);
+	JsonObject &add(const char *key, uint64 value);
+	JsonObject &add(const char *key, bool value);
+	/** nullptr gives null. */
+	JsonObject &add(const char *key, const char *value);
+	JsonObject &add(const char *key, const Common::String &value);
+	JsonObject &addNull(const char *key);
+	/** @p json must already be valid JSON (a nested object or array). */
+	JsonObject &addRaw(const char *key, const Common::String &json);
+	Common::String str() const;
+
+private:
+	Common::String _members; // comma-separated "key":value pairs
+};
+
+/** Builds one JSON array; elements appear in the order they are added. */
+class JsonArray {
+public:
+	JsonArray &add(int value);
+	/** @p json must already be valid JSON. */
+	JsonArray &addRaw(const Common::String &json);
+	JsonArray &add(const JsonObject &value) { return addRaw(value.str()); }
+	bool empty() const { return _elements.empty(); }
+	Common::String str() const;
+
+private:
+	Common::String _elements;
+};
+
+/**
+ * A JSON Lines file (the trace, contract C5): one value per line, flushed
+ * as soon as it is written. The file is written in place, not through the
+ * temporary file DumpFile renames over the target on close, so a run that
+ * crashes or is killed keeps every line written so far.
+ */
+class JsonlWriter {
+public:
+	/** Create or truncate @p path, creating its parent directories as needed. */
+	bool open(const Common::Path &path);
+	bool isOpen() const { return _file.isOpen(); }
+	/** Append @p json and a newline, then flush. Warns once if writing fails. */
+	void writeLine(const Common::String &json);
+	void close() { _file.close(); }
+
+private:
+	/** DumpFile::open(path, true) creates the directories, then calls open(node). */
+	class InPlaceFile : public Common::DumpFile {
+	public:
+		using Common::DumpFile::open;
+		bool open(const Common::FSNode &node) override;
+	};
+
+	InPlaceFile _file;
+	Common::String _name; // for the warning
+	bool _writeFailed = false;
+};
+
+/**
+ * Write @p json and a newline to @p path, creating its parent directories.
+ * Atomic: readers see the old file or the whole new one, never a part.
+ */
+bool writeJsonFile(const Common::Path &path, const Common::String &json);
+
+} // End of namespace Scumm
+
+#endif
